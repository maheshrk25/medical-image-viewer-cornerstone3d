{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "medical-image-viewer-cornerstone3d-webgl": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "public"}, {"glob": "charlswasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-charls/dist", "output": "cs-dicom-loader/codecs/codec-charls"}, {"glob": "libjpegturbowasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-libjpeg-turbo-8bit/dist", "output": "cs-dicom-loader/codecs/codec-libjpeg-turbo-8bit"}, {"glob": "openjpegwasm_decode.wasm", "input": "node_modules/@cornerstonejs/codec-openjpeg/dist", "output": "cs-dicom-loader/codecs/codec-openjpeg"}, {"glob": "openjphjs.wasm", "input": "node_modules/@cornerstonejs/codec-openjph/dist", "output": "cs-dicom-loader/codecs/codec-openjph"}],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "10MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "medical-image-viewer-cornerstone3d-webgl:build:production"
            },
            "development": {
              "buildTarget": "medical-image-viewer-cornerstone3d-webgl:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
