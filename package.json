{
  "name": "medical-image-viewer-cornerstone3d-webgl",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:subpath": "ng build --base-href /subpath/",
    "preview": "node scripts/bundle-dicom-worker.js && node scripts/copy-codec-wasm.js && ng build && npx serve dist/angular-vite-6/browser -s -l 4201",
    "preview:subpath": "node scripts/bundle-dicom-worker.js && node scripts/copy-codec-wasm.js && npm run build:subpath && npx serve dist/angular-vite-6/browser -s -l 4202 --cors",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "postinstall": "node scripts/install-node-stubs.js && node scripts/bundle-dicom-worker.js && node scripts/copy-codec-wasm.js",
    "prebuild": "node scripts/bundle-dicom-worker.js && node scripts/copy-codec-wasm.js",
    "bundle:worker": "node scripts/bundle-dicom-worker.js",
    "copy:codec-wasm": "node scripts/copy-codec-wasm.js"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@cornerstonejs/core": "^5.15.2",
    "@cornerstonejs/dicom-image-loader": "^5.15.2",
    "@cornerstonejs/tools": "^5.15.2",
    "events": "^3.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
